# Supabase Configuration (Main Expense Tracker)
NEXT_PUBLIC_SUPABASE_URL=your_main_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_main_supabase_anon_key

# -------------------------------------------------------------
# Phase 3: External Live Sync (Direct Database / Sheet Access)
# -------------------------------------------------------------

# 1. Room Fund (Public Google Sheet CSV Link)
ROOM_FUND_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-your-sheet-id/pub?output=csv

# 2. IT Lab Fund (Separate Supabase Project for 'Cash in hand')
LAB_SUPABASE_URL=https://your-lab-project.supabase.co
LAB_SUPABASE_ANON_KEY=your-lab-anon-key

# 3. Store Fund (MongoDB URI for Bank + Cash Trial Balance)
STORE_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/store_db

# -------------------------------------------------------------
# Phase 4: AI Assistant (Function Calling)
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
